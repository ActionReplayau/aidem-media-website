---
import Base from '../../layouts/Base.astro';
import Ph from '../../components/Ph.astro';
import { site } from '../../site';
---
<Base title="Contact" description="Contact Aidem Media in Beaconsfield VIC to book event filming." current="contact">
  <section class="hero">
    <div class="wrap">
      <p class="crumb"><a href="/">Home</a> / Contact</p>
      <span class="label">Contact</span>
      <h1>Let's talk about<br>your event.</h1>
      <p class="lead"><Ph>Tell us the date, the venue and what you'd like filmed. We'll get back to you with what's included and a price.</Ph></p>
    </div>
  </section>
  <section class="no-top">
    <div class="wrap stack" style="gap:40px">
      <div class="contact-list">
        <div><span class="label">Phone</span><a href={site.phoneHref}>{site.phone}</a></div>
        <div><span class="label">Email</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
        <div><span class="label">Based in</span><p>{site.location}</p></div>
      </div>
      <form class="contact-form" id="form" method="post" action="/api/contact">
        <h2>Send us a message</h2>
        <p class="form-error" id="form-error" hidden></p>
        <div class="field-row">
          <div class="field"><label for="f-name">Your name</label><input id="f-name" name="name" autocomplete="name" required maxlength="120" /></div>
          <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" required maxlength="200" /></div>
        </div>
        <div class="field-row">
          <div class="field"><label for="f-phone">Phone <span>(optional)</span></label><input id="f-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /></div>
          <div class="field"><label for="f-event">What's the event?</label>
            <select id="f-event" name="event">
              <option>School concert</option><option>Graduation</option><option>Dance concert</option>
              <option>Corporate event</option><option>Funeral</option><option>Something else</option>
            </select>
          </div>
        </div>
        <div class="field"><label for="f-date">Date and venue <span>(if you know them)</span></label><input id="f-date" name="date" maxlength="60" /></div>
        <div class="field"><label for="f-message">Message</label><textarea id="f-message" name="message" rows="6" required maxlength="5000"></textarea></div>
        <div class="trap" aria-hidden="true"><label for="f-company">Leave this empty</label><input id="f-company" name="company" tabindex="-1" autocomplete="off" /></div>
        <div><button class="btn" type="submit">Send message</button></div>
      </form>
      <script is:inline>
        (function () {
          var e = new URLSearchParams(location.search).get('error');
          if (!e) return;
          var el = document.getElementById('form-error');
          el.textContent = e === '1'
            ? 'Please fill in your name, a valid email address and a message, then try again.'
            : "Sorry, your message couldn't be sent just now. Please email or call us instead.";
          el.hidden = false;
        })();
      </script>
      <div class="notice">
        <strong>Ordering a concert video?</strong>
        <p>Parents can order directly online. <a href={site.orderUrl}>Go to concert orders</a>.</p>
      </div>
      <div class="notice">
        <strong>Converting old tapes, film or photos?</strong>
        <p>That's our sister business. <a href={site.actionReplayUrl}>Visit Action Replay</a>.</p>
      </div>
    </div>
  </section>
</Base>
