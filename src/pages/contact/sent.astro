---
import Base from '../../layouts/Base.astro';
import { site } from '../../site';
---
<Base title="Message sent" description="Thanks for getting in touch with Aidem Media." current="contact">
  <section class="hero">
    <div class="wrap stack">
      <span class="label">Contact</span>
      <h1>Thanks, your message is on its way.</h1>
      <p class="lead">We'll get back to you soon. If it's urgent, call {site.phone}.</p>
      <div class="actions"><a class="btn" href="/">Back to the homepage</a></div>
    </div>
  </section>
</Base>
