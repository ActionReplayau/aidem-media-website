---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found.">
  <section class="hero">
    <div class="wrap stack">
      <h1>That page isn't here.</h1>
      <p class="lead">It may have moved when we updated the website.</p>
      <div class="actions"><a class="btn" href="/">Go to the homepage</a><a class="btn ghost" href="/contact/">Contact us</a></div>
    </div>
  </section>
</Base>
