---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---
<Base title="Privacy policy" description="How Aidem Media handles your personal information." current="privacy">
  <section class="hero">
    <div class="wrap stack">
      <p class="crumb"><a href="/">Home</a> / Privacy policy</p>
      <h1>Privacy policy</h1>
      <p class="lead"><span class="ph">Placeholder. Matt to supply or approve the full privacy policy before this site goes live.</span></p>
      <p>Questions about privacy? Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</Base>
